# =====================================================================
# DevMsr.in — environment variables (PLACEHOLDERS ONLY)
#
# Local development (Cloudflare workerd runtime): copy to `.dev.vars`
#   cp .env.example .dev.vars
# Production: set each value as a Cloudflare Worker secret:
#   npx wrangler secret put SUPABASE_SECRET_KEY
# Never commit real values. All of these are read on the server only.
# =====================================================================

# Supabase project (Project Settings → API). Leave empty to run the site
# from bundled seed data without a database (forms will be unavailable).
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…): used server-side for public reads and admin sessions.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Secret key (sb_secret_…): server-only, used ONLY for lead intake, rate limiting and notification logs.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# 32+ random characters. Signs form tokens and hashes IPs for rate limiting.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_SECRET=replace-with-at-least-32-random-characters

# Resend (https://resend.com). EMAIL_FROM must use exactly the domain verified in Resend.
# Replace every placeholder below: Resend rejects example.com recipients (HTTP 422).
RESEND_API_KEY=re_replace_me
EMAIL_FROM="DevMsr.in <notify@devmsr.in>"
OWNER_NOTIFICATION_EMAIL=owner@example.com
# "true" to send prospects an acknowledgement email with their reference.
SEND_LEAD_ACKNOWLEDGEMENT=false

# Cloudflare Turnstile (optional but recommended). Leave both empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bearer token for POST /api/cron/retry-notifications (optional).
CRON_SECRET=

---
/** How a custom project runs, from enquiry to support. Used on several pages. */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const STEPS = [
  { title: 'Enquiry', body: 'You describe the problem through a form, call or demo request. You get a reference number straight away.' },
  { title: 'Scoping', body: 'We ask about the work your team does today — roles, rules, documents — not only the features you have in mind.' },
  { title: 'Written quote', body: 'Features in scope and out of scope, one figure for development, and third-party costs listed separately.' },
  { title: 'Build & review', body: 'Work starts once you approve the scope and the agreed advance is paid. You review in steps, on real devices.' },
  { title: 'Launch & support', body: 'Deployment on your domain, a handover session and an agreed support period. Maintenance is optional.' },
];
---

<ol class:list={['grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line', compact ? 'sm:grid-cols-2 lg:grid-cols-5' : 'md:grid-cols-5']}>
  {
    STEPS.map((step, index) => (
      <li class="flex flex-col bg-surface p-5 sm:p-6">
        <span class="font-mono text-[0.75rem] text-clay-ink">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 font-display text-[1.25rem] leading-tight text-ink">{step.title}</h3>
        <p class="text-small mt-2 text-ink-muted">{step.body}</p>
      </li>
    ))
  }
</ol>

---
import { ArrowRight } from '@lucide/astro';
import ProductStatusBadge from '../ui/ProductStatusBadge.astro';
import type { Product } from '../../types/catalogue';

interface Props {
  products: Product[];
  headingLevel?: 'h2' | 'h3';
}
const { products, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

{
  products.length === 0 ? (
    <p class="text-ink-muted">No packaged products in this area yet. We build these systems as custom projects.</p>
  ) : (
    <ul class="divide-y divide-line border-y border-line">
      {products.map((product) => (
        <li>
          <a href={`/products/${product.slug}`} class="group grid gap-2 py-5 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto] sm:items-center sm:gap-6">
            <span class="flex items-center gap-3">
              <Heading class="font-display text-[1.25rem] leading-tight text-ink">{product.name}</Heading>
            </span>
            <span class="text-small text-ink-muted">{product.summary}</span>
            <span class="flex items-center gap-3 sm:justify-end">
              <ProductStatusBadge status={product.status} />
              <ArrowRight size={16} aria-hidden="true" class="text-ink-muted transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

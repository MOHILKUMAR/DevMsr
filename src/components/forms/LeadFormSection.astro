---
import { actions } from 'astro:actions';
import LeadForm from './LeadForm';
import { loadCatalogue } from '../../lib/catalogue/repository';
import { getServerConfig } from '../../lib/server/config';
import { issueFormToken } from '../../lib/security/tokens';
import { SERVICE_CATEGORY_CONTENT } from '../../data/service-categories';
import type { LeadFormType } from '../../schemas/lead';
import { readPrefill, resolvePrefill, type PrefillOptions } from '../../lib/forms/prefill';

/**
 * Server-side setup for a lead form: per-render idempotency key, signed
 * form token, Turnstile site key and pre-selections. Site links pass them
 * after "#" (read by LeadForm in the browser); "?" links from outside the
 * site are read here. See lib/forms/prefill.
 */
interface Props {
  formType: LeadFormType;
}
const { formType } = Astro.props;

const config = getServerConfig();
const catalogue = await loadCatalogue(Astro.locals);

const industries = [...catalogue.industries].sort((a, b) => a.sortOrder - b.sortOrder).map((i) => ({ value: i.slug, label: i.name }));
const prefillOptions: PrefillOptions = {
  industries: industries.map((industry) => industry.value),
  categories: SERVICE_CATEGORY_CONTENT.map((category) => category.slug),
  services: catalogue.services.map((s) => ({ slug: s.slug, name: s.name, industry: s.industrySlugs.length === 1 ? (s.industrySlugs[0] ?? null) : null })),
  products: catalogue.products.map((p) => ({ slug: p.slug, name: p.name, industry: p.industrySlug ?? null, category: p.serviceCategory ?? null })),
};
const fromQuery = resolvePrefill(readPrefill(Astro.url.search), prefillOptions);

const interests = [
  ...(fromQuery.service ? [{ label: 'Selected service', options: [fromQuery.service] }] : []),
  { label: 'Service type', options: SERVICE_CATEGORY_CONTENT.map((c) => ({ value: `category:${c.slug}`, label: c.name })) },
];
// The browser only needs what site links can ask for: services on the quote form, products on the demo form.
const browserPrefill: PrefillOptions = {
  industries: prefillOptions.industries,
  categories: prefillOptions.categories,
  ...(formType === 'quote' ? { services: prefillOptions.services } : {}),
  ...(formType === 'demo' ? { products: prefillOptions.products } : {}),
};

const actionResult = Astro.getActionResult(actions.leads.submit);
const initialOutcome = actionResult?.data ?? (actionResult?.error ? { status: 'unavailable' as const, message: 'Something went wrong. Please try again.' } : null);

const formToken = config.appSecret ? await issueFormToken(config.appSecret) : '';
---

<LeadForm
  client:load
  formType={formType}
  industries={industries}
  interests={interests}
  defaults={{ industry: fromQuery.industry, interest: fromQuery.interest, productName: fromQuery.productName }}
  prefillOptions={browserPrefill}
  submissionId={crypto.randomUUID()}
  formToken={formToken}
  turnstileSiteKey={config.turnstile?.siteKey ?? null}
  actionUrl={actions.leads.submit.queryString}
  sourcePath={Astro.url.pathname}
  initialOutcome={initialOutcome}
  fallbackEmail={catalogue.settings.contactEmail}
/>

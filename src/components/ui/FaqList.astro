---
import { Plus } from '@lucide/astro';
import type { Faq } from '../../types/catalogue';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

{
  faqs.length === 0 ? (
    <p class="text-ink-muted">No questions here yet. Ask us directly through the contact form.</p>
  ) : (
    <div class="divide-y divide-line border-y border-line">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left font-medium text-ink marker:hidden [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <Plus size={18} aria-hidden="true" class="mt-1 shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <p class="max-w-2xl pb-6 pr-10 text-ink-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  )
}

---
/**
 * Renders a Lucide icon from a stored name (e.g. industries.icon).
 * Only icons in this allow-list can be rendered; unknown names fall back
 * to a neutral square so admin-entered values cannot break a page.
 */
import {
  Stethoscope,
  BedDouble,
  Utensils,
  Store,
  Plane,
  GraduationCap,
  LayoutTemplate,
  ShoppingBag,
  Blocks,
  LayoutDashboard,
  Receipt,
  Contact,
  Workflow,
  MessageSquare,
  PhoneCall,
  Plug,
  ServerCog,
  Building,
  Square,
} from '@lucide/astro';
import type { IconName } from '../../lib/catalogue/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const ICONS = {
  stethoscope: Stethoscope,
  'bed-double': BedDouble,
  utensils: Utensils,
  store: Store,
  plane: Plane,
  'graduation-cap': GraduationCap,
  'layout-template': LayoutTemplate,
  'shopping-bag': ShoppingBag,
  blocks: Blocks,
  'layout-dashboard': LayoutDashboard,
  receipt: Receipt,
  contact: Contact,
  workflow: Workflow,
  'message-square': MessageSquare,
  'phone-call': PhoneCall,
  plug: Plug,
  'server-cog': ServerCog,
  building: Building,
} as const satisfies Record<IconName, unknown>;


const { name, size = 18, class: className } = Astro.props;
const Icon = ICONS[name as keyof typeof ICONS] ?? Square;
---

<Icon size={size} class={className} aria-hidden="true" />

---
import { ChevronRight } from '@lucide/astro';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-muted">
    <li><a href="/" class="hover:text-ink">Home</a></li>
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          <ChevronRight size={14} aria-hidden="true" class="text-ink-faint" />
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="hover:text-ink">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

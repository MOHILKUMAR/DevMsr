---
import PreviewFrame from './PreviewFrame.astro';
import type { PreviewKind } from '../../data/industries';

interface Props {
  kind: PreviewKind;
  class?: string;
}
const { kind, class: className } = Astro.props;

const LABELS: Record<PreviewKind, string> = {
  'opd-token': 'Illustration: OPD token board with per-doctor queues (sample data)',
  'room-board': 'Illustration: hotel room status board (sample data)',
  'kitchen-tickets': 'Illustration: kitchen order display with open tickets (sample data)',
  'stock-grid': 'Illustration: footwear stock by size and colour (sample data)',
  itinerary: 'Illustration: day-wise travel itinerary (sample data)',
  'fee-ledger': 'Illustration: student fee ledger (sample data)',
};

const rooms = [
  { no: '101', state: 'occ' }, { no: '102', state: 'clean' }, { no: '103', state: 'dirty' }, { no: '104', state: 'occ' },
  { no: '105', state: 'occ' }, { no: '106', state: 'block' }, { no: '201', state: 'clean' }, { no: '202', state: 'occ' },
  { no: '203', state: 'dirty' }, { no: '204', state: 'clean' }, { no: '205', state: 'occ' }, { no: '206', state: 'occ' },
] as const;
const ROOM_TONE = {
  occ: 'bg-invert text-invert-ink border-transparent',
  clean: 'bg-olive-wash text-olive border-olive-soft',
  dirty: 'bg-clay-soft text-clay-ink border-transparent',
  block: 'bg-bg-sunken text-ink-muted border-line border-dashed',
} as const;

const sizes = ['6', '7', '8', '9', '10', '11'];
const stock = [
  { colour: 'Black', qty: [4, 9, 12, 7, 2, 0] },
  { colour: 'Tan', qty: [2, 5, 6, 3, 1, 1] },
  { colour: 'White', qty: [0, 3, 8, 8, 4, 2] },
];
---

<div role="img" aria-label={LABELS[kind]} class={className}>
  {
    kind === 'opd-token' && (
      <PreviewFrame title="OPD queue" meta="Waiting-area display">
        <div class="grid grid-cols-3 gap-2" aria-hidden="true">
          {[
            { dept: 'General OPD', now: 'A-14', next: 'A-15', wait: 9 },
            { dept: 'Paediatrics', now: 'B-07', next: 'B-08', wait: 4 },
            { dept: 'Orthopaedics', now: 'C-03', next: 'C-04', wait: 6 },
          ].map((q) => (
            <div class="rounded-lg border border-line bg-bg p-3">
              <p class="truncate font-mono text-[0.625rem] uppercase tracking-[0.06em] text-ink-muted">{q.dept}</p>
              <p class="mt-2 text-[0.6875rem] text-ink-muted">Now</p>
              <p class="font-display text-[1.75rem] leading-none text-ink">{q.now}</p>
              <p class="mt-2 text-[0.6875rem] text-ink-muted">Next {q.next}</p>
              <p class="text-[0.6875rem] text-ink-muted">{q.wait} waiting</p>
            </div>
          ))}
        </div>
        <div class="mt-3 flex items-center justify-between rounded-lg bg-olive-wash px-3 py-2 text-olive" aria-hidden="true">
          <span>Token A-15 · please proceed to Room 2</span>
          <span class="font-mono text-[0.6875rem]">10:42</span>
        </div>
      </PreviewFrame>
    )
  }
  {
    kind === 'room-board' && (
      <PreviewFrame title="Room board" meta="Today">
        <div class="grid grid-cols-4 gap-1.5 sm:grid-cols-6" aria-hidden="true">
          {rooms.map((room) => (
            <div class:list={['rounded-md border px-2 py-2 text-center font-mono text-[0.75rem]', ROOM_TONE[room.state]]}>{room.no}</div>
          ))}
        </div>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[0.6875rem] text-ink-muted" aria-hidden="true">
          <li class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-invert" />Occupied 6</li>
          <li class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-olive" />Vacant clean 3</li>
          <li class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-clay" />To clean 2</li>
          <li class="flex items-center gap-1.5"><span class="size-2 rounded-sm border border-dashed border-ink-faint" />Blocked 1</li>
        </ul>
      </PreviewFrame>
    )
  }
  {
    kind === 'kitchen-tickets' && (
      <PreviewFrame title="Kitchen display" meta="Hot station">
        <div class="grid grid-cols-3 gap-2" aria-hidden="true">
          {[
            { ticket: 'Table 4', time: '06:12', late: false, items: ['2 × Paneer tikka', '1 × Dal makhani', '4 × Butter naan'] },
            { ticket: 'Takeaway 23', time: '11:40', late: true, items: ['1 × Veg biryani', '2 × Raita'] },
            { ticket: 'Table 9', time: '02:05', late: false, items: ['3 × Masala dosa', '1 × Filter coffee'] },
          ].map((t) => (
            <div class:list={['rounded-lg border bg-bg p-2.5', t.late ? 'border-clay' : 'border-line']}>
              <div class="flex items-baseline justify-between gap-1">
                <p class="truncate font-medium text-ink">{t.ticket}</p>
                <p class:list={['font-mono text-[0.6875rem]', t.late ? 'text-clay-ink' : 'text-ink-muted']}>{t.time}</p>
              </div>
              <ul class="mt-2 space-y-1 text-[0.6875rem] text-ink-muted">
                {t.items.map((item) => <li class="truncate">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </PreviewFrame>
    )
  }
  {
    kind === 'stock-grid' && (
      <PreviewFrame title="Stock by size" meta="Runner 2.0 · all stores">
        <table class="w-full text-left" aria-hidden="true">
          <thead>
            <tr class="text-ink-muted">
              <th class="pb-2 font-normal">Colour</th>
              {sizes.map((size) => <th class="pb-2 text-center font-mono text-[0.6875rem] font-normal">UK {size}</th>)}
            </tr>
          </thead>
          <tbody class="tabular">
            {stock.map((row) => (
              <tr class="border-t border-line">
                <td class="py-2 text-ink">{row.colour}</td>
                {row.qty.map((qty) => (
                  <td class="py-2 text-center">
                    <span class:list={['inline-block min-w-7 rounded px-1.5 py-0.5', qty === 0 ? 'bg-danger-soft text-danger' : qty <= 2 ? 'bg-warning-soft text-warning' : 'text-ink']}>{qty}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-3 text-[0.6875rem] text-ink-muted" aria-hidden="true">2 sizes out of stock · re-order suggested for UK 10–11</p>
      </PreviewFrame>
    )
  }
  {
    kind === 'itinerary' && (
      <PreviewFrame title="Itinerary" meta="Kerala · 4 nights">
        <ol class="relative space-y-3 border-l border-line pl-4" aria-hidden="true">
          {[
            { day: 'Day 1', title: 'Arrive Kochi', detail: 'Airport pickup · Fort Kochi walk · Overnight Kochi' },
            { day: 'Day 2', title: 'Munnar', detail: 'Tea gardens · Mattupetty dam · Overnight Munnar' },
            { day: 'Day 3', title: 'Thekkady', detail: 'Spice plantation · Periyar boat ride' },
            { day: 'Day 4', title: 'Alleppey', detail: 'Houseboat check-in · Backwater cruise' },
          ].map((d) => (
            <li class="relative">
              <span class="absolute -left-[1.3rem] top-1 size-2 rounded-full bg-clay" />
              <p class="font-mono text-[0.625rem] uppercase tracking-[0.08em] text-ink-muted">{d.day}</p>
              <p class="font-medium text-ink">{d.title}</p>
              <p class="text-[0.75rem] text-ink-muted">{d.detail}</p>
            </li>
          ))}
        </ol>
      </PreviewFrame>
    )
  }
  {
    kind === 'fee-ledger' && (
      <PreviewFrame title="Fee ledger" meta="Class 7 · Term 2">
        <table class="w-full text-left" aria-hidden="true">
          <thead>
            <tr class="text-ink-muted">
              <th class="pb-2 font-normal">Student</th>
              <th class="pb-2 text-right font-normal">Due</th>
              <th class="pb-2 text-right font-normal">Paid</th>
              <th class="pb-2 text-right font-normal">Status</th>
            </tr>
          </thead>
          <tbody class="tabular">
            {[
              { name: 'Roll 01', due: '₹18,500', paid: '₹18,500', status: 'Paid', tone: 'bg-success-soft text-success' },
              { name: 'Roll 02', due: '₹18,500', paid: '₹9,250', status: 'Partial', tone: 'bg-warning-soft text-warning' },
              { name: 'Roll 03', due: '₹18,500', paid: '₹0', status: 'Overdue', tone: 'bg-danger-soft text-danger' },
              { name: 'Roll 04', due: '₹16,000', paid: '₹16,000', status: 'Paid', tone: 'bg-success-soft text-success' },
            ].map((r) => (
              <tr class="border-t border-line">
                <td class="py-2 text-ink">{r.name}</td>
                <td class="py-2 text-right text-ink-muted">{r.due}</td>
                <td class="py-2 text-right text-ink">{r.paid}</td>
                <td class="py-2 text-right"><span class:list={['rounded-full px-2 py-0.5 text-[0.6875rem]', r.tone]}>{r.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </PreviewFrame>
    )
  }
</div>

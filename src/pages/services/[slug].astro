---
import { ArrowRight, Check, Minus, Clock, Link2, Repeat } from '@lucide/astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FaqList from '../../components/ui/FaqList.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import DynamicIcon from '../../components/ui/DynamicIcon.astro';
import PriceList from '../../components/services/PriceList.astro';
import ProductList from '../../components/services/ProductList.astro';
import { getServiceCategoryContent, SERVICE_CATEGORY_CONTENT } from '../../data/service-categories';
import { BUSINESS } from '../../data/business';
import { loadCatalogue } from '../../lib/catalogue/repository';
import { faqsFor, pricesForService, pricesForServices, productsForCategory, serviceMap, servicesForCategory } from '../../lib/catalogue/queries';
import { formatFromPrice, lowestPrice } from '../../lib/catalogue/pricing';
import { SERVICE_STATUS_LABELS } from '../../lib/catalogue/labels';
import { breadcrumbJsonLd, compact, faqJsonLd, serviceJsonLd } from '../../lib/seo';
import { FILL_LAST_2_3 } from '../../lib/utils/grid';

const slug = Astro.params.slug ?? '';
const content = getServiceCategoryContent(slug);
if (!content) {
  return Astro.rewrite('/404');
}

const catalogue = await loadCatalogue(Astro.locals);
const services = servicesForCategory(catalogue, content.slug);
const allServices = serviceMap(catalogue);
const prices = pricesForServices(catalogue, services);
const lowest = lowestPrice(prices);
const products = productsForCategory(catalogue, content.slug);
const faqs = faqsFor(catalogue, 'service_category', content.slug);
const industriesBySlug = new Map(catalogue.industries.map((industry) => [industry.slug, industry]));
const path = `/services/${content.slug}`;
const related = SERVICE_CATEGORY_CONTENT.filter((category) => category.slug !== content.slug).slice(0, 4);
---

<MarketingLayout
  title={content.seoTitle}
  description={content.seoDescription}
  jsonLd={compact([
    breadcrumbJsonLd([
      { name: 'Services', path: '/services' },
      { name: content.name, path },
    ]),
    serviceJsonLd({
      name: content.name,
      description: content.intro,
      path,
      prices: prices.map((price) => ({ label: price.label ?? allServices.get(price.serviceSlug)?.name ?? '', price })),
    }),
    faqJsonLd(faqs),
  ])}
>
  <section class="page-container pb-14 pt-8 sm:pt-10">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: content.name }]} />
    <div class="mt-10 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="text-eyebrow flex items-center gap-2">
          <span class="text-olive"><DynamicIcon name={content.icon} size={16} /></span>
          {content.name}
        </p>
        <h1 class="text-h1 mt-5">{content.tagline}</h1>
        <p class="text-lede mt-5 max-w-2xl">{content.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`/request-quote?category=${content.slug}`} size="lg">Request a quote <ArrowRight size={17} aria-hidden="true" /></Button>
          <Button href="#pricing" size="lg" variant="secondary">See pricing</Button>
        </div>
      </div>
      <aside class="self-end lg:col-span-4" aria-label="At a glance">
        <dl class="divide-y divide-line rounded-[var(--radius-card)] border border-line bg-surface text-small">
          <div class="flex items-start gap-3 p-4">
            <dt class="w-20 shrink-0 pt-0.5 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink-muted">Cost</dt>
            <dd class="text-ink">{lowest ? `${formatFromPrice(lowest)} · GST extra` : 'Quoted per scope'}</dd>
          </div>
          <div class="flex items-start gap-3 p-4">
            <dt class="w-20 shrink-0 pt-0.5 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink-muted">Timeline</dt>
            <dd class="text-ink">{content.typicalTimeline}</dd>
          </div>
          <div class="flex items-start gap-3 p-4">
            <dt class="w-20 shrink-0 pt-0.5 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink-muted">Services</dt>
            <dd class="text-ink">{services.length} listed below</dd>
          </div>
          <div class="flex items-start gap-3 p-4">
            <dt class="w-20 shrink-0 pt-0.5 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-ink-muted">Based in</dt>
            <dd class="text-ink">{BUSINESS.address.locality} · working across Delhi NCR and India</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="border-y border-line bg-surface" aria-labelledby="what-title">
    <div class="page-container section-space grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader id="what-title" eyebrow="What it does" title={`What you get with ${content.name}.`} />
        <p class="mt-5 text-ink-muted">{content.whatItDoes}</p>
        <h3 class="mt-10 font-semibold text-ink">Who needs it</h3>
        <ul class="mt-3 space-y-2">
          {content.whoNeedsIt.map((item) => <li class="flex gap-2.5"><span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-clay" />{item}</li>)}
        </ul>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7">
        <div>
          <h3 class="font-semibold text-ink">Key features</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {content.keyFeatures.map((item) => <li class="flex gap-2.5"><Check size={16} aria-hidden="true" class="mt-1 shrink-0 text-olive" />{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-ink">Typical use cases</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {content.useCases.map((item) => <li class="flex gap-2.5"><ArrowRight size={16} aria-hidden="true" class="mt-1 shrink-0 text-ink-faint" />{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-ink">Included</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {content.included.map((item) => <li class="flex gap-2.5"><Check size={16} aria-hidden="true" class="mt-1 shrink-0 text-olive" />{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-ink">Not included</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {content.excluded.map((item) => <li class="flex gap-2.5"><Minus size={16} aria-hidden="true" class="mt-1 shrink-0 text-ink-faint" />{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="page-container section-space" aria-labelledby="services-title">
    <SectionHeader class="mb-10" id="services-title" eyebrow="Services" title={`${content.name} services`} />
    {
      services.length === 0 ? (
        <p class="text-ink-muted">No services are listed in this category right now. <a class="link-olive" href="/contact">Ask us directly</a>.</p>
      ) : (
        <ul class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => {
            const price = lowestPrice(pricesForService(catalogue, service.slug));
            const industryNames = service.industrySlugs.map((s) => industriesBySlug.get(s)?.name).filter(Boolean);
            return (
              <li class:list={['flex flex-col bg-surface p-5', FILL_LAST_2_3]}>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-medium text-ink">{service.name}</h3>
                  {service.status === 'on_request' && <Badge tone="clay">{SERVICE_STATUS_LABELS.on_request}</Badge>}
                </div>
                <p class="text-small mt-1.5 flex-1 text-ink-muted">{service.shortDescription}</p>
                {industryNames.length > 0 && <p class="mt-3 text-[0.75rem] text-ink-muted">{industryNames.join(' · ')}</p>}
                <p class="mt-3 font-mono text-[0.8125rem] text-ink">{price ? formatFromPrice(price) : 'Quoted per scope'}</p>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section id="pricing" class="scroll-mt-24 bg-bg-sunken" aria-labelledby="pricing-title">
    <div class="page-container section-space grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader id="pricing-title" eyebrow="Indicative cost" title="Pricing and running costs" />
        <p class="mt-5 text-ink-muted">
          Development fees are one-time unless marked monthly. Final cost depends on scope, integrations, data migration, testing and deployment.
        </p>
        <div class="mt-8 space-y-6">
          <div class="flex gap-3">
            <Clock size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-olive" />
            <div>
              <h3 class="font-semibold text-ink">Typical timeline</h3>
              <p class="text-small mt-1 text-ink-muted">{content.typicalTimeline}</p>
            </div>
          </div>
          <div class="flex gap-3">
            <Link2 size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-olive" />
            <div>
              <h3 class="font-semibold text-ink">Depends on</h3>
              <ul class="text-small mt-1 space-y-1 text-ink-muted">{content.dependencies.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
          <div class="flex gap-3">
            <Repeat size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-olive" />
            <div>
              <h3 class="font-semibold text-ink">Recurring costs (billed separately)</h3>
              <dl class="text-small mt-1 space-y-2">
                {content.recurringCosts.map((cost) => (
                  <div>
                    <dt class="text-ink">{cost.item}</dt>
                    <dd class="text-ink-muted">{cost.note}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7">
        <PriceList catalogue={catalogue} prices={prices} detailed />
        <p class="text-small mt-4 text-ink-muted">
          Starting estimates, not final quotes. <a href="/payments" class="link-olive">How payments work</a>.
        </p>
      </div>
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="page-container section-space" aria-labelledby="products-title">
        <SectionHeader class="mb-8" id="products-title" eyebrow="Products" title="Related products" />
        <ProductList products={products} />
      </section>
    )
  }

  {
    faqs.length > 0 && (
      <section class="border-t border-line" aria-labelledby="faq-title">
        <div class="page-container section-space grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <SectionHeader id="faq-title" eyebrow="Questions" title="Common questions" />
          </div>
          <div class="lg:col-span-8">
            <FaqList faqs={faqs} />
          </div>
        </div>
      </section>
    )
  }

  <section class="page-container border-t border-line pt-14" aria-labelledby="next-title">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="next-title" class="text-h2">Next steps</h2>
        <ol class="mt-6 space-y-3 text-ink-muted">
          <li><span class="mr-2 font-mono text-[0.75rem] text-clay-ink">01</span>Send a quote request with a rough description.</li>
          <li><span class="mr-2 font-mono text-[0.75rem] text-clay-ink">02</span>We reply with questions or a short call.</li>
          <li><span class="mr-2 font-mono text-[0.75rem] text-clay-ink">03</span>You receive a written scope and quote.</li>
        </ol>
      </div>
      <div class="lg:col-span-7">
        <p class="text-eyebrow mb-4">Related services</p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            related.map((category) => (
              <li>
                <a href={`/services/${category.slug}`} class="flex items-center justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3 hover:border-line-strong">
                  <span class="font-medium text-ink">{category.name}</span>
                  <ArrowRight size={16} aria-hidden="true" class="text-ink-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand primaryHref={`/request-quote?category=${content.slug}`} />
</MarketingLayout>

---
import { ArrowUpRight } from '@lucide/astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { loadPortfolio } from '../../lib/catalogue/repository';
import { breadcrumbJsonLd } from '../../lib/seo';

const projects = await loadPortfolio(Astro.locals);
const TYPE_LABEL = { client: 'Client project', internal: 'Internal project', prototype: 'Prototype' } as const;
---

<MarketingLayout
  title="Portfolio"
  description="Projects and prototypes built by DevMsr.in, each labelled as client work, internal project or prototype."
  jsonLd={[breadcrumbJsonLd([{ name: 'Portfolio', path: '/portfolio' }])]}
>
  <section class="page-container pb-12 pt-8 sm:pt-10">
    <Breadcrumbs items={[{ label: 'Portfolio' }]} />
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="text-h1 lg:col-span-7">Portfolio</h1>
      <p class="text-lede lg:col-span-5">
        Every entry says whether it is client work, an internal project or a prototype. Client work appears only with the client’s permission.
      </p>
    </div>
  </section>

  <section class="page-container pb-16" aria-label="Projects">
    {
      projects.length === 0 ? (
        <div class="rounded-[var(--radius-card)] border border-dashed border-line-strong p-10 text-center">
          <p class="font-medium text-ink">Case studies are being prepared.</p>
          <p class="mt-1 text-ink-muted">
            In the meantime, <a class="link-olive" href="/book-a-demo">book a demo</a> and we will walk you through relevant work.
          </p>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {projects.map((project) => (
            <li>
              <a href={`/portfolio/${project.slug}`} class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 transition-colors hover:border-line-strong sm:p-8">
                {project.imageUrls[0] && (
                  <img src={project.imageUrls[0]} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="mb-6 aspect-[16/10] w-full rounded-lg border border-line object-cover" />
                )}
                <Badge tone={project.projectType === 'client' ? 'olive' : 'neutral'} class="self-start">{TYPE_LABEL[project.projectType]}</Badge>
                <h2 class="text-h3 mt-4 flex items-start justify-between gap-3 group-hover:underline">
                  {project.title}
                  <ArrowUpRight size={20} aria-hidden="true" class="mt-1 shrink-0 text-ink-muted" />
                </h2>
                <p class="mt-2 flex-1 text-ink-muted">{project.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {project.technologyStack.map((tech) => (
                    <li class="rounded-md border border-line bg-bg px-2 py-0.5 font-mono text-[0.6875rem] text-ink-muted">{tech}</li>
                  ))}
                </ul>
              </a>
            </li>
          ))}
          <li class="flex flex-col justify-center rounded-[var(--radius-card)] border border-dashed border-line-strong p-8">
            <p class="font-display text-[1.375rem] text-ink">More work is on the way.</p>
            <p class="mt-2 text-ink-muted">We add client projects as they launch and clients agree to be listed.</p>
          </li>
        </ul>
      )
    }
  </section>
  <CtaBand />
</MarketingLayout>

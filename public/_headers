# Security headers for static assets served directly by Cloudflare.
# Worker-rendered pages get equivalent headers from src/middleware.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Share images: file names change when their text changes, so they can be cached for good.
/og/*
  Cache-Control: public, max-age=31536000, immutable
